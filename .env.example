# =============================================================================
# VoiceShield Production Environment Configuration
# =============================================================================

# Service Ports & Host Binding
PORT=8000
STREAMLIT_PORT=8501
HOST=0.0.0.0

# Redis Queue & PubSub Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Model Checkpoint & Inference Settings
DEVICE=cpu
BACKEND_API_URL=http://localhost:8000
BACKEND_WS_URL=ws://localhost:8000
DEFAULT_NEURAL_CHECKPOINT=models/voiceshield_neural_best.pt
PRIMARY_TRANSFORMER_MODEL=MelodyMachine/Deepfake-audio-detection-V2
FALLBACK_TRANSFORMER_MODEL=garystafford/wav2vec2-deepfake-voice-detector
TEMPERATURE_SCALING=1.35
EMA_SMOOTHING_ALPHA=0.35

# Logging & Telemetry
LOG_LEVEL=INFO
DEBUG=False
